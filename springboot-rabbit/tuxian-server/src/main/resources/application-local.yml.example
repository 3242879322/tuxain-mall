# =====================================================================
# 本地开发配置模板
#
# 用法：复制本文件为同目录下的 application-local.yml，然后把 CHANGE_ME
#       换成你自己的值。application-local.yml 已被 .gitignore 排除。
#
#   copy application-local.yml.example application-local.yml
#
# 这些值之所以单独放这里，是因为 application.yml 要提交到公开仓库，
# 不能带真实的数据库密码和 JWT 签名密钥。
# =====================================================================

spring:
  datasource:
    # 与 application.yml 里的 datasource.url / username 配套
    password: CHANGE_ME

tuxian:
  jwt:
    # JWT 签名密钥，长度建议 32 位以上随机字符串，用户端与管理端必须不同
    user-secret-key: CHANGE_ME
    admin-secret-key: CHANGE_ME